# --- Anthropic (Pro tier) ---
# Owner: A — Railway only, jangan pernah expose ke frontend
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_SONNET=claude-sonnet-4-6

# --- Provider Alternatif (Free tier) ---
# Owner: A — Railway only
FREE_TIER_PROVIDER=openrouter
FREE_TIER_API_KEY=your-openrouter-api-key-here
FREE_TIER_BASE_URL=https://openrouter.ai/api/v1
FREE_TIER_MODEL_NAME=deepseek/deepseek-chat

# --- Supabase ---
# SUPABASE_SERVICE_ROLE_KEY dan SUPABASE_DB_URL: A only — jangan pernah ke frontend
# SUPABASE_URL dan SUPABASE_ANON_KEY: boleh dibagikan ke B untuk frontend
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# --- LangSmith ---
# Owner: A — Railway only
LANGCHAIN_API_KEY=ls__your-langsmith-api-key-here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=lamar-ai

# --- Sentry ---
# SENTRY_DSN_BACKEND: A → Railway
# SENTRY_DSN_FRONTEND: A bagikan ke B → Vercel
SENTRY_DSN_BACKEND=https://your-backend-key@sentry.io/your-project-id
SENTRY_DSN_FRONTEND=https://your-frontend-key@sentry.io/your-project-id

# --- App Config ---
# NEXT_PUBLIC_*: B set di Vercel (dapat dari A)
# ADMIN_EMAIL dan ALLOWED_ORIGINS: A set di Railway
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
ADMIN_EMAIL=your-admin-email@example.com
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# --- LLM Settings ---
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# --- QC Settings ---
MAX_QC_ITERATIONS=3
ATS_THRESHOLD=70
SEMANTIC_THRESHOLD=65
QC_COMBINED_WEIGHT_ATS=0.5
QC_COMBINED_WEIGHT_SEMANTIC=0.5

# --- Content Settings ---
TOP_N_EXPERIENCE=3
TOP_N_PROJECTS=3
TOP_N_AWARDS=3
TOP_N_EDUCATION=2
TOP_N_ORGANIZATIONS=2
TOP_N_CERTIFICATES=5
TOP_N_SKILLS=15
BULLET_MAX_WORDS=20

# --- Tier & Usage Settings ---
FREE_TIER_MAX_APPLICATIONS=3

# --- Storage Settings ---
SIGNED_URL_EXPIRY_SECONDS=3600
